{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northern Lines Studio",
  "version": "0.26.0-alpha.1",
  "identifier": "de.northernlines.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Northern Lines Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Travel",
    "fileAssociations": [
      {
        "ext": [
          "nls"
        ],
        "name": "Northern Lines Reise",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-northern-lines-studio",
        "contentTypes": [
          "de.northernlines.studio.nls"
        ],
        "exportedType": {
          "identifier": "de.northernlines.studio.nls",
          "conformsTo": [
            "com.apple.package"
          ]
        }
      }
    ]
  }
}
