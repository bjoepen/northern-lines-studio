{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northern Lines Studio",
  "version": "0.2.0",
  "identifier": "de.northernlines.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Northern Lines Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
